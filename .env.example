# Next.js 서버 설정
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# VirusTotal
VIRUSTOTAL_API_KEY=

# External API auth
DEFAULT_API_KEY=
EXTERNAL_API_KEYS=

# Neon Postgres (기업용 베타 사전신청, 회원 사전등록, 하루 분석 횟수 저장)
DATABASE_URL=

# 하루 무료 분석 횟수 (기본 5, 바꾸면 utils/quotaConfig.js 의 화면 문구 값도 함께 바꾼다)
ANALYSIS_DAILY_LIMIT=5
# IP 해시용 솔트 (임의의 긴 문자열)
QUOTA_SALT=

# Cloudflare Turnstile (둘 다 비우면 사람 확인을 건너뛴다)
# 로컬 테스트용 항상 통과 키: 사이트 1x00000000000000000000AA / 시크릿 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 로깅
LOG_LEVEL=info
