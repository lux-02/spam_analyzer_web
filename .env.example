# 환경 설정 예시 파일
# .env 파일로 복사한 후 실제 값으로 변경하여 사용하세요

# VirusTotal API 키 - 필수 입력
VIRUSTOTAL_API_KEY=여기에_실제_API_키_입력

# MongoDB URI
MONGODB_URI=mongodb://mongo:27017/spam_analyzer

# Flask 서버 URL (배포 시 공인 IP로 변경)
FLASK_SERVER_URL=http://localhost:5001

# 포트 설정
FLASK_PORT=5001
NEXT_PORT=3000

# 운영 모드
NODE_ENV=production
