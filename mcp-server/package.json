{
  "name": "spam-analyzer-mcp-server",
  "version": "1.0.0",
  "description": "MCP Server for Email Security Analysis",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "HTTP_MODE=true node start-http-server.js",
    "dev": "tsx src/index.ts",
    "dev:http": "HTTP_MODE=true tsx src/index.ts",
    "watch": "tsx watch src/index.ts",
    "test": "node test-server.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "email-security",
    "spam-analysis",
    "phishing-detection"
  ],
  "author": "LUX",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "axios": "^1.6.8",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "date-fns": "^3.5.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "js-base64": "^3.7.7",
    "mongodb": "^6.16.0",
    "mongoose": "^8.14.3",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  }
}
